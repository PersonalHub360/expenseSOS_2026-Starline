# Copy to .env for local development. Do not commit .env.

NODE_ENV=development
DATABASE_URL=postgresql://USER@localhost:5432/starline_property
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://127.0.0.1:5173
PORT=4000

# Used only by `npm run db:seed`. The seed command refuses to run when NODE_ENV=production.
DEMO_ADMIN_EMAIL=demo.admin@starline.local
DEMO_ADMIN_USERNAME=demo.admin
DEMO_ADMIN_PASSWORD=admin@starline.com

# Optional, and only for the first real administrator when the users table is empty.
# `npm run db:bootstrap` does not insert demo projects.
# BOOTSTRAP_ADMIN_EMAIL=admin@starline.com
# BOOTSTRAP_ADMIN_USERNAME=admin1122
# BOOTSTRAP_ADMIN_PASSWORD=admin@starline.com

# Integration tests refuse any URL that does not point at the test database.
DATABASE_URL_TEST=postgresql://USER@localhost:5432/starline_property_test
